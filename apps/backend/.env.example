# Database — SQLite по умолчанию для dev (не требует Docker).
# Для PostgreSQL: замените на "postgresql://dev:dev@localhost:5432/tpu_dev"
# и в schema.prisma: provider = "postgresql"
DATABASE_URL="file:./dev.db"

# JWT secrets — в проде сгенерируйте длинные случайные строки
JWT_ACCESS_SECRET="dev-access-secret-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Cookie settings
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""

# CORS — список через запятую
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# App
PORT="3000"
NODE_ENV="development"

# TPU OAuth — оставлено пустым, конфигурация появится когда оживёте
TPU_OAUTH_CLIENT_ID=""
TPU_OAUTH_CLIENT_SECRET=""
TPU_OAUTH_REDIRECT_URI="http://localhost:5173/auth/callback"

# Admin emails — кому выдавать роль ADMIN при входе через TPU
ADMIN_EMAILS="admin@tpu.ru"
