# Базовый URL API.
# В dev с VITE_USE_MOCKS=true — должно быть '/api' (относительный путь, перехватывается middleware'ем).
# В dev с живым бэком — 'http://localhost:3000' (тогда прокси Vite направит /api → :3000).
# В проде — '/api' (Nginx проксирует) или абсолютный URL вроде https://your-app.onrender.com.
VITE_API_URL=/api

# true — включить mock-API (Vite middleware отдаёт JSON из src/mocks/).
# false — ходить через прокси на VITE_API_URL (настоящий бэкенд).
VITE_USE_MOCKS=true

# TPU OAuth client_id из https://api.tpu.ru/dashboard.
# Авторизация ТПУ сейчас не работает из-за мёртвого бэкенда,
# но когда оживёте — подставите сюда реальный client_id.
VITE_TPU_OAUTH_CLIENT_ID=
