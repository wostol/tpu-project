{
  "name": "tpu-project",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:user": "npm --workspace apps/user-site run dev",
    "dev:backend": "npm --workspace apps/backend run start:dev",
    "build:user": "npm --workspace apps/user-site run build",
    "build:backend": "npm --workspace apps/backend run build",
    "build": "npm run build --workspaces",
    "db:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.dev.yml down",
    "prisma:migrate": "npm --workspace apps/backend run prisma:migrate",
    "prisma:seed": "npm --workspace apps/backend run prisma:seed",
    "prisma:studio": "npm --workspace apps/backend run prisma:studio"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "bcrypt@5.1.1": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "dependencies": {
    "gsap": "^3.15.1"
  }
}
